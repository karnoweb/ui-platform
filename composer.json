{
    "name": "karnoweb/laravel-tenant-ui",
    "description": "Multi-tenant UI configuration, theme, page builder and publish runtime package for Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "multi-tenant",
        "ui",
        "theme",
        "page-builder"
    ],
    "authors": [
        {
            "name": "Karnoweb",
            "email": "info@karnoweb.com"
        }
    ],
    "version": "13.0.0",
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/container": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/events": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "KarnoWeb\\TenantUi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KarnoWeb\\TenantUi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "KarnoWeb\\TenantUi\\TenantUiServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
